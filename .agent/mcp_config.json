{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "YOUR_API_KEY"
            ]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "firebase": {
            "command": "npx",
            "args": [
                "-y",
                "firebase-tools@latest",
                "mcp"
            ]
        },
        "firebase-crashlytics": {
            "command": "npx",
            "args": [
                "-y",
                "@firebase/crashlytics-mcp"
            ],
            "env": {
                "GOOGLE_APPLICATION_CREDENTIALS": "/mnt/Dados1/Estudos/APPDOWNLOADYOUTUBE/android/app/firebase-key.json"
            }
        }
    }
}
