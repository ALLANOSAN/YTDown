<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- FIX #20: Block cleartext traffic by default, only allow HTTPS -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext only for localhost (e.g. local dev server) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <!-- Allow Metal-Archives (may have SSL issues) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">metal-archives.com</domain>
    </domain-config>
</network-security-config>
