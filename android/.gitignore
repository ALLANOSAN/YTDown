# O wrapper do Gradle (gradlew, gradlew.bat e gradle-wrapper.jar) TEM de ser
# versionado — e o que faz o build ser reproduzivel sem Gradle instalado.
# Estava ignorado por heranca do template Flutter e o CI quebrava com
# "chmod: cannot access 'android/gradlew'".
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
