{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Refactor DownloadService",
			"type": "shell",
			"command": "python3 refactor_service.py",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Analyze DownloadService",
			"type": "shell",
			"command": "flutter analyze lib/services/download_service.dart",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Refactor Phase 2",
			"type": "shell",
			"command": "python3 -c \"import re\nfile_path = 'lib/services/download_service.dart'\nwith open(file_path, 'r', encoding='utf-8') as f:\n    c = f.read()\n\nc = re.sub(r'_downloadQueue\\.add', 'DownloadQueueService.instance.addTask', c)\nc = re.sub(r'_updateController\\.stream', 'DownloadProgressService.instance.downloadUpdates', c)\nc = re.sub(r'_updateController', 'DownloadProgressService.instance', c)\nc = re.sub(r'_locks\\.containsKey(\\(.*?)\\)', r'DownloadQueueService.instance.hasLock\\1)', c)\nc = re.sub(r'var lock = _locks\\[videoId\\];', '', c)\nc = re.sub(r'await _locks\\[videoId\\]!\\.future;', 'await DownloadQueueService.instance.waitLock(videoId);', c)\nc = re.sub(r'_locks\\[videoId\\] = Completer<void>\\(\\);', 'DownloadQueueService.instance.acquireLock(videoId);', c)\nc = re.sub(r'_locks\\[videoId\\]!\\.complete\\(\\);', 'DownloadQueueService.instance.releaseLock(videoId);', c)\nc = re.sub(r'_locks\\.remove\\(videoId\\);', '', c)\n\nif 'import \\'download_queue_service.dart\\';' not in c:\n    c = c.replace('import \\'../utils/ffmpeg_utils.dart\\';', 'import \\'../utils/ffmpeg_utils.dart\\';\\\\nimport \\'download_queue_service.dart\\';\\\\nimport \\'download_progress_service.dart\\';\\\\nimport \\'download_metadata_service.dart\\';')\n\nopen(file_path, 'w', encoding='utf-8').write(c)\"",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Analyze After Fix",
			"type": "shell",
			"command": "flutter analyze lib/services/download_service.dart",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Git Checkout",
			"type": "shell",
			"command": "git checkout lib/services/download_service.dart",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Analyze Service",
			"type": "shell",
			"command": "flutter analyze lib/services/download_service.dart",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Analyze Service After Imports",
			"type": "shell",
			"command": "flutter analyze lib/services/download_service.dart",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Analysis to txt",
			"type": "shell",
			"command": "flutter analyze lib/services/download_service.dart > _analysis.txt",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Sed Fix",
			"type": "shell",
			"command": "sed -i 's|DownloadProgressService.instance.add(|DownloadProgressService.instance.addUpdate(|g' lib/services/download_service.dart\nsed -i 's|DownloadProgressService.instance.close()|DownloadProgressService.instance.dispose()|g' lib/services/download_service.dart",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Verify Analysis",
			"type": "shell",
			"command": "flutter analyze lib/services/download_service.dart",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "List Methods",
			"type": "shell",
			"command": "python3 list_methods.py",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Dump widget",
			"type": "shell",
			"command": "cat lib/widgets/download_card.dart > _widget_card.txt",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Check MD3",
			"type": "shell",
			"command": "cat lib/theme/app_theme.dart | grep useMaterial3",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Dump Provider",
			"type": "shell",
			"command": "cat lib/providers/download_provider.dart > _provider.txt",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Clean Provider",
			"type": "shell",
			"command": "python3 rm_progress_provider.py",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Refactor Card",
			"type": "shell",
			"command": "python3 refactor_card.py",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Analyze After T4",
			"type": "shell",
			"command": "flutter analyze",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Verify Card",
			"type": "shell",
			"command": "cat lib/widgets/download_card.dart | grep -A 5 -B 5 \"Widget _buildProgressBar\"",
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Find progress uses",
			"type": "shell",
			"command": "cat lib/widgets/download_card.dart | grep \"\\.progress\"",
			"isBackground": false,
			"group": "build"
		}
	]
}